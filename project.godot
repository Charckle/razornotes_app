; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="razor_app"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"
run/main_scene="res://menus/account_select/account_select.tscn"

[autoload]

AccountManager="*res://autoloads/account_manager.gd"
ApiClient="*res://autoloads/api_client.gd"
LocalStorage="*res://autoloads/local_storage.gd"

[display]

window/size/viewport_width=400
window/size/viewport_height=800

[rendering]

renderer/rendering_method="mobile"
